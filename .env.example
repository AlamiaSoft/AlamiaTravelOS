# ==============================================================================
# AlamiaTravelOS - Odoo 19 Community Docker Configuration
# ==============================================================================

# Project Name (used as docker container/network prefix)
COMPOSE_PROJECT_NAME=alamiatravelos

# Odoo Version & Image Configuration
ODOO_VERSION=19.0
ODOO_IMAGE=odoo:19.0
WEB_PORT=8069
CHAT_PORT=8072

# Odoo Master Password (used for database creation/drop/backup management)
ODOO_ADMIN_PASSWORD=supersecret_master_password_change_me

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo_db_secure_password_123
DB_NAME=alamia_travel_db

# PostgreSQL Image
POSTGRES_VERSION=17-alpine

# Production Domain (for reverse proxy / SSL)
DOMAIN=travelos.example.com
LETSENCRYPT_EMAIL=admin@example.com
