<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_travel_sale_form_finance" model="ir.ui.view">
            <field name="name">travel.sale.form.finance</field>
            <field name="model">travel.sale</field>
            <field name="inherit_id" ref="alamia_travel_sales.view_travel_sale_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" 
                            invisible="state == 'draft' or amount_invoiced &gt; 0"/>
                    <button name="action_create_vendor_bills" string="Create Vendor Bills" type="object" 
                            invisible="state == 'draft'"/>
                </xpath>
                
                <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_bills" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_status != 'paid'"/>
                    <widget name="web_ribbon" title="Partial" bg_color="text-bg-warning" invisible="payment_status != 'partial'"/>
                </xpath>

                <xpath expr="//group[@name='sale_total']" position="after">
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="financial_status">
                        <field name="amount_invoiced" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_due" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Account Move Inherit -->
        <record id="view_move_form_travel" model="ir.ui.view">
            <field name="name">account.move.form.travel</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="travel_sale_id" invisible="not travel_sale_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
