<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_travel_service_catalog_form" model="ir.ui.view">
            <field name="name">travel.service.catalog.form</field>
            <field name="model">travel.service.catalog</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Airline Ticket"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Accounting" name="accounting">
                                <group>
                                    <field name="income_account_id"/>
                                    <field name="expense_account_id"/>
                                </group>
                            </page>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_travel_service_catalog_list" model="ir.ui.view">
            <field name="name">travel.service.catalog.list</field>
            <field name="model">travel.service.catalog</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_travel_service_catalog" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">travel.service.catalog</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Travel Service
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_travel_services"
                  name="Services"
                  parent="menu_travel_configuration"
                  action="action_travel_service_catalog"
                  sequence="10"/>
    </data>
</odoo>
