<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Service Catalog Form View -->
        <record id="view_travel_service_catalog_form" model="ir.ui.view">
            <field name="name">travel.service.catalog.form</field>
            <field name="model">travel.service.catalog</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Saudi Visit Visa"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="category"/>
                                <field name="sequence"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Standard Pricing">
                                <field name="list_price"/>
                                <field name="standard_cost"/>
                                <field name="target_margin" widget="percentage"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Accounting" name="accounting">
                                <group>
                                    <field name="income_account_id"/>
                                    <field name="expense_account_id"/>
                                </group>
                            </page>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Service Catalog List View -->
        <record id="view_travel_service_catalog_list" model="ir.ui.view">
            <field name="name">travel.service.catalog.list</field>
            <field name="model">travel.service.catalog</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="list_price"/>
                    <field name="standard_cost"/>
                    <field name="target_margin"/>
                </list>
            </field>
        </record>

        <!-- Service Catalog Action -->
        <record id="action_travel_service_catalog" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">travel.service.catalog</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Travel Service
                </p>
            </field>
        </record>

        <!-- Service Package List View -->
        <record id="view_travel_service_package_tree" model="ir.ui.view">
            <field name="name">travel.service.package.tree</field>
            <field name="model">travel.service.package</field>
            <field name="arch" type="xml">
                <list string="Travel Packages &amp; Bundles">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="total_selling_price"/>
                    <field name="total_cost_price"/>
                    <field name="expected_profit"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Service Package Form View -->
        <record id="view_travel_service_package_form" model="ir.ui.view">
            <field name="name">travel.service.package.form</field>
            <field name="model">travel.service.package</field>
            <field name="arch" type="xml">
                <form string="Package / Bundle">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="e.g. Umrah 15 Days Economy Package"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="active"/>
                            </group>
                            <group string="Package Financials">
                                <field name="total_selling_price"/>
                                <field name="total_cost_price"/>
                                <field name="expected_profit"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Package Services &amp; Line Items">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="service_id"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="cost_price"/>
                                        <field name="selling_amount"/>
                                        <field name="cost_amount"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description" placeholder="Inclusions, terms, or itinerary highlights..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Service Package Action -->
        <record id="action_travel_service_package" model="ir.actions.act_window">
            <field name="name">Package Bundles</field>
            <field name="res_model">travel.service.package</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Travel Package Bundle!
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_travel_services"
                  name="Services"
                  parent="menu_travel_configuration"
                  action="action_travel_service_catalog"
                  groups="alamia_travel_core.group_travel_manager,alamia_travel_core.group_travel_admin"
                  sequence="10"/>

        <menuitem id="menu_travel_service_packages"
                  name="Package Bundles"
                  parent="menu_travel_configuration"
                  action="action_travel_service_package"
                  groups="alamia_travel_core.group_travel_manager,alamia_travel_core.group_travel_admin"
                  sequence="15"/>
    </data>
</odoo>
