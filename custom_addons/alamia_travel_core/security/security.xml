<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_alamia_travel" model="res.groups.privilege">
            <field name="name">Travel OS</field>
        </record>

        <record id="group_travel_ops" model="res.groups">
            <field name="name">Operations Staff</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_travel_sales" model="res.groups">
            <field name="name">Sales Staff</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_ops'))]"/>
        </record>

        <record id="group_travel_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_sales'))]"/>
        </record>

        <record id="group_travel_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- 5 Specific Organizational Roles (Sprint: Kamal Express Users & Roles) -->
        <record id="travel_role_ceo" model="res.groups">
            <field name="name">CEO</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_manager')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
        </record>

        <record id="travel_role_operations_director" model="res.groups">
            <field name="name">Head/Director Operations</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_manager')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="travel_role_sales_director" model="res.groups">
            <field name="name">Head/Director Sales &amp; Customer Relations</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_sales')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="travel_role_operations_marketing" model="res.groups">
            <field name="name">Assistant Manager Operations &amp; Marketing</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_sales')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="travel_role_it_director" model="res.groups">
            <field name="name">Head/Director IT &amp; Software</field>
            <field name="privilege_id" ref="module_category_alamia_travel"/>
            <field name="implied_ids" eval="[(4, ref('group_travel_admin')), (4, ref('base.group_system')), (4, ref('base.group_erp_manager'))]"/>
        </record>
    </data>
</odoo>
