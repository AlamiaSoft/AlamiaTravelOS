<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Schedule Task Wizard Form View -->
        <record id="view_travel_schedule_activity_wizard_form" model="ir.ui.view">
            <field name="name">travel.schedule.activity.wizard.form</field>
            <field name="model">travel.schedule.activity.wizard</field>
            <field name="arch" type="xml">
                <form string="Schedule Task / To-Do Item">
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="activity_type_id" options="{'no_create': True}"/>
                            <field name="date_deadline"/>
                        </group>
                        <group>
                            <field name="summary" placeholder="e.g. Follow up on Hajj package quotation"/>
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Enter task instructions or details..."/>
                    </group>
                    <footer>
                        <button name="action_schedule_task" string="Schedule &amp; Assign Task" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Window Action for Task Scheduling Wizard -->
        <record id="action_travel_schedule_activity_wizard" model="ir.actions.act_window">
            <field name="name">Schedule Task / To-Do</field>
            <field name="res_model">travel.schedule.activity.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Top Navigation Bar Shortcut Menu -->
        <menuitem id="menu_travel_schedule_task"
                  name="Schedule Task / To-Do"
                  parent="alamia_travel_core.menu_travel_os_root"
                  action="action_travel_schedule_activity_wizard"
                  sequence="90"/>
    </data>
</odoo>
