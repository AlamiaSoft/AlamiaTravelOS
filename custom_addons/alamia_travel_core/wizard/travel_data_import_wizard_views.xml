<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_travel_data_import_wizard_form" model="ir.ui.view">
            <field name="name">travel.data.import.wizard.form</field>
            <field name="model">travel.data.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Historical Data Workbook">
                    <sheet>
                        <div class="oe_title">
                            <h2>Import Excel Data Workbook</h2>
                        </div>
                        <group>
                            <group>
                                <field name="file" filename="filename" widget="binary"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <group>
                                <field name="purge_existing"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_import" string="Import Data" type="object" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                        <group string="Import Summary" invisible="not summary_text">
                            <field name="summary_text" nolabel="1" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_travel_data_import_wizard" model="ir.actions.act_window">
            <field name="name">Excel Data Import</field>
            <field name="res_model">travel.data.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_travel_data_import_wizard"
                  name="Excel Data Import"
                  parent="alamia_travel_core.menu_travel_os_root"
                  action="action_travel_data_import_wizard"
                  sequence="90"/>
    </data>
</odoo>
